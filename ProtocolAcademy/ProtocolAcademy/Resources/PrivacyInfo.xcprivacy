<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Privacy manifest for the app target.

	  As shipped, Protocol Academy has no analytics, no accounts, no network calls of
	  its own, and stores progress only in UserDefaults on device — so it tracks
	  nothing and collects nothing.

	  IMPORTANT: adding a third-party ad SDK changes this file. The SDK ships its own
	  privacy manifest, but you must still set NSPrivacyTracking to true, list the
	  network's tracking domains in NSPrivacyTrackingDomains, and declare the data
	  types it collects. See Docs/ADS_INTEGRATION.md.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Learning progress and the ad-personalisation preference are stored in
			     UserDefaults and read only by this app. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
